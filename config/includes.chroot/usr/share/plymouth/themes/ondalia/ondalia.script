# Pantalla de arranque de Ondalia OS.
# Fondo en degradado azul profundo y el logo de la ola latiendo suavemente.

Window.SetBackgroundTopColor(0.000, 0.106, 0.243);     # #001B3E
Window.SetBackgroundBottomColor(0.000, 0.184, 0.424);  # #002F6C

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

# Latido suave del logo (entre 70 % y 100 % de opacidad).
tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.85 + 0.15 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Contraseña para discos cifrados ---
fun display_password_callback(prompt, bullets) {
    global.prompt_image = Image.Text(prompt, 0.92, 0.96, 0.98);
    global.prompt_sprite = Sprite(global.prompt_image);
    global.prompt_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.prompt_image.GetWidth() / 2,
                                     logo.y + logo.image.GetHeight() + 50, 10);
    global.prompt_sprite.SetOpacity(1);

    dots = "";
    for (i = 0; i < bullets; i++)
        dots += "*";
    global.dots_image = Image.Text(dots, 0.0, 0.737, 0.831);   # cian #00BCD4
    global.dots_sprite = Sprite(global.dots_image);
    global.dots_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.dots_image.GetWidth() / 2,
                                   logo.y + logo.image.GetHeight() + 80, 10);
    global.dots_sprite.SetOpacity(1);
}

fun display_normal_callback() {
    if (global.prompt_sprite)
        global.prompt_sprite.SetOpacity(0);
    if (global.dots_sprite)
        global.dots_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Mensajes (por ejemplo, comprobación de disco) ---
fun message_callback(text) {
    global.msg_image = Image.Text(text, 0.75, 0.82, 0.88);
    global.msg_sprite = Sprite(global.msg_image);
    global.msg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - global.msg_image.GetWidth() / 2,
                                  Window.GetY() + Window.GetHeight() - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);

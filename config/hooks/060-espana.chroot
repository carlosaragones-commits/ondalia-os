#!/usr/bin/env bash
# Administración electrónica española: DNIe, lectores de tarjetas y AutoFirma.
# El módulo del DNIe se carga en Firefox desde /etc/firefox/policies/policies.json.
source /tmp/ondalia/hooks/lib.sh

install_available pcscd libccid opensc opensc-pkcs11 libnss3-tools default-jre
systemctl enable pcscd.socket 2>/dev/null || true

# AutoFirma: paquete oficial del Gobierno de España para Debian y derivados.
# El enlace cambia con cada versión, así que primero se busca en la página
# oficial de descargas y, si no aparece, se prueban las direcciones conocidas.
SITE=https://firmaelectronica.gob.es
TMP=$(mktemp -d)
AUTOFIRMA_URLS=()
for page in "$SITE/ciudadanos/descargas" "$SITE/Home/Descargas.html"; do
    if wget -nv -O "$TMP/descargas.html" "$page"; then
        while IFS= read -r href; do
            [[ $href == http* ]] || href="$SITE$href"
            AUTOFIRMA_URLS+=("$href")
        done < <(grep -oiE 'href="[^"]*linux_debian[^"]*\.zip"' "$TMP/descargas.html" |
            sed -E 's/^href="//I; s/"$//' | sort -u)
    fi
done
AUTOFIRMA_URLS+=(
    "https://estaticos.redsara.es/comunes/autofirma/currentversion/Autofirma_Linux_Debian.zip"
    "https://estaticos.redsara.es/comunes/autofirma/currentversion/AutoFirma_Linux_Debian.zip"
)

ok=0
for url in "${AUTOFIRMA_URLS[@]}"; do
    log "Descargando AutoFirma: $url"
    if wget -nv -O "$TMP/autofirma.zip" "$url" && unzip -tq "$TMP/autofirma.zip" >/dev/null; then
        ok=1
        break
    fi
done

if ((ok)); then
    unzip -q -o "$TMP/autofirma.zip" -d "$TMP"
    DEB=$(find "$TMP" -iname 'autofirma*.deb' | head -n1)
    if [[ -n $DEB ]]; then
        apt_get install "$DEB"
        log "AutoFirma instalada"
    else
        ok=0
        warn "El ZIP de AutoFirma no contiene ningún .deb"
    fi
fi
rm -rf "$TMP"

if ((!ok)); then
    if [[ ${AUTOFIRMA_REQUIRED:-0} == 1 ]]; then
        warn "No se pudo instalar AutoFirma y AUTOFIRMA_REQUIRED=1"
        exit 1
    fi
    warn "AutoFirma NO se ha incluido en esta ISO. Revisa la URL de descarga."
fi
